FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/lumen-venv \
    PATH=/opt/lumen-venv/bin:${PATH}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        ninja-build \
        pkg-config \
        python3.10 \
        python3.10-dev \
        python3.10-venv \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY tools/hf_zerogpu/space_template/requirements.txt /tmp/lumen-requirements.txt
COPY tools/fine_tuning/unsloth/training_lineage.py /tmp/lumen-training-lineage.py

RUN python3.10 -m venv "${VIRTUAL_ENV}" \
    && python -m pip install \
        pip==26.1.1 \
        setuptools==80.9.0 \
        wheel==0.46.3 \
    && python -m pip install \
        torch==2.9.1 \
        torchvision==0.24.1 \
        torchaudio==2.9.1 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install -r /tmp/lumen-requirements.txt \
    && python -m pip check \
    && python - <<'PY'
import importlib.metadata as metadata
import importlib.util
import json
import platform
from pathlib import Path

import torch

assert platform.python_version_tuple()[:2] == ("3", "10"), platform.python_version()
assert torch.__version__.split("+", 1)[0] == "2.9.1", torch.__version__
assert torch.version.cuda == "12.8", torch.version.cuda

spec = importlib.util.spec_from_file_location(
    "lumen_training_lineage", "/tmp/lumen-training-lineage.py"
)
assert spec is not None and spec.loader is not None
lineage = importlib.util.module_from_spec(spec)
spec.loader.exec_module(lineage)
dependency_lock = lineage.build_training_dependency_lock(
    Path("/tmp/lumen-requirements.txt")
)
unsloth_direct_url = json.loads(
    metadata.distribution("unsloth").read_text("direct_url.json") or "{}"
)
lineage.verify_training_dependency_lock(
    dependency_lock,
    requirements_path=Path("/tmp/lumen-requirements.txt"),
    installed_versions=lineage.installed_controlled_package_versions(
        dependency_lock
    ),
    installed_unsloth_revision=(
        unsloth_direct_url.get("vcs_info", {}).get("commit_id")
    ),
    runtime_python_version=".".join(platform.python_version_tuple()[:2]),
    runtime_cuda_version=str(torch.version.cuda or ""),
)
PY

# Hash every installed RECORD under an unprivileged identity while the image
# layer is still being built. This makes permission, containment, duplicate,
# and content drift fail before the GPU runtime is launched.
RUN setpriv --reuid=nobody --regid=nogroup --init-groups python - <<'PY'
import importlib.util
import json

spec = importlib.util.spec_from_file_location(
    "lumen_training_lineage", "/tmp/lumen-training-lineage.py"
)
assert spec is not None and spec.loader is not None
lineage = importlib.util.module_from_spec(spec)
spec.loader.exec_module(lineage)
environment, scan = lineage.build_resolved_training_environment_snapshot()
digest = lineage.verify_resolved_training_environment(environment)
if (
    scan["resolvedTrainingEnvironmentSHA256"] != digest
    or scan["distributionCount"] <= 0
    or scan["installedFileCount"] <= 0
    or scan["totalHashedBytes"] <= 0
):
    raise RuntimeError("Resolved training environment build scan is empty or inconsistent")
print(json.dumps(scan, sort_keys=True))
PY

WORKDIR /workspace

CMD ["/bin/bash"]
