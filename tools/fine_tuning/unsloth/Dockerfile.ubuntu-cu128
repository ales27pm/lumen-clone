FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/lumen-venv \
    PATH=/opt/lumen-venv/bin:${PATH}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        ninja-build \
        pkg-config \
        python3.10 \
        python3.10-dev \
        python3.10-venv \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY tools/hf_zerogpu/space_template/requirements.txt /tmp/lumen-requirements.txt

RUN python3.10 -m venv "${VIRTUAL_ENV}" \
    && python -m pip install \
        pip==26.1.1 \
        setuptools==80.9.0 \
        wheel==0.46.3 \
    && python -m pip install \
        torch==2.9.1 \
        torchvision==0.24.1 \
        torchaudio==2.9.1 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install -r /tmp/lumen-requirements.txt \
    && python -m pip check \
    && python - <<'PY'
import platform

import torch

assert platform.python_version_tuple()[:2] == ("3", "10"), platform.python_version()
assert torch.__version__.split("+", 1)[0] == "2.9.1", torch.__version__
assert torch.version.cuda == "12.8", torch.version.cuda
PY

WORKDIR /workspace

CMD ["/bin/bash"]
